# Copier en .env (jamais commité) et remplir.

# Nom de domaine pointant vers le VPS (enregistrement DNS A). localhost pour un essai local.
DOMAIN=localhost

# Mot de passe Postgres : python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Jeton saisi dans les réglages de l'app : python -c "import secrets; print(secrets.token_urlsafe(32))"
MOTIVPLAN_API_TOKEN=
